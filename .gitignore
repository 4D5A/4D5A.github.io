# Jekyll build output and caches — regenerated on every build, never commit
_site/
.jekyll-cache/
.jekyll-metadata

# Bundler local state — regenerated by `bundle install`
.bundle/
vendor/bundle/

# Gemfile.lock is intentionally not committed: a lockfile generated on one
# platform (e.g. Windows dev machine) records only that platform and can
# break CI/GitHub Pages builds running on a different one.
Gemfile.lock

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
